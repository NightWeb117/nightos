{
  "name": "nightos-desktop",
  "productName": "NightOS",
  "version": "1.5.0",
  "description": "NightOS as a Windows desktop app that can launch Discord, Steam and your Steam games.",
  "author": "NightWeb117",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.nightweb117.nightos",
    "productName": "NightOS",
    "copyright": "NightOS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "steam.js",
      "updater.js",
      "winfs.js",
      "wintasks.js",
      "flatpak.js",
      "selftest.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../site",
        "to": "site"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "NightWeb117",
        "repo": "nightos",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NightOS",
      "artifactName": "NightOS-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "NightOS-${version}-portable.exe"
    }
  }
}
